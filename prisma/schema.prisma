generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique @db.VarChar(100)
  password         String            @db.VarChar(255)
  name             String            @db.VarChar(150)
  role             String            @db.VarChar(50)
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  production_codes Production_code[]
  sales            Sale[]

  @@map("User")
}

model Customer {
  id      Int     @id @default(autoincrement())
  name    String
  address String? @db.VarChar(255)
  contact String? @db.VarChar(50)

  production_codes Production_code[]
  sales            Sale[]

  @@map("customers")
}

model Product {
  id               Int               @id @default(autoincrement())
  product_name     String
  product_type     String            @db.VarChar(100)
  product_codes    Product_code[]
  production_codes Production_code[]
  sale_items       Sale_item[]
  product_prices   Product_price[]

  @@map("products")
}

model Product_price {
  id         Int       @id @default(autoincrement())
  price      Int
  product_id Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@map("product_prices")
}

model Product_code {
  id               Int               @id @default(autoincrement())
  product_code     String
  product_id       Int
  product          Product           @relation(fields: [product_id], references: [id])
  production_codes Production_code[]

  @@map("product_codes")
}

model Production_code {
  id                  Int           @id @default(autoincrement())
  product_id          Int
  product_code_id     Int?
  batch               String?       @db.VarChar(100)
  production_number   String?       @db.VarChar(100)
  production_code     String?       @db.VarChar(255)
  spk                 String?       @db.VarChar(100)
  remarks             String?
  out_code_date       DateTime?     @db.Date
  item_code_recipient String?       @db.VarChar(255)
  status              String?       @db.VarChar(100)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?     @updatedAt @db.Timestamptz(6)
  customer_id         Int?
  user_id             Int
  customer            Customer?     @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  product_code        Product_code? @relation(fields: [product_code_id], references: [id])
  product             Product       @relation(fields: [product_id], references: [id])
  user                User          @relation(fields: [user_id], references: [id])

  @@map("production_codes")
}

model Sale {
  id            Int       @id @default(autoincrement())
  no_spk        String?   @db.VarChar(100) //E-SPK/2026/09/10134 atau R-SPK
  no_po         String?   @db.VarChar(100)
  spk_date      DateTime  @default(now()) @db.Timestamptz(6)
  expected_date DateTime? @db.Timestamptz(6)
  spk_type      String    @db.VarChar(100)
  customer_id   Int
  sales_person  String?   @db.VarChar(100)

  total_amount  Decimal @default(0) @db.Decimal(12, 2)
  shipping_cost Decimal @default(0) @db.Decimal(12, 2)
  ecatalog      String  @db.VarChar(100)
  status        String  @default("On Progress") @db.VarChar(50)
  remarks       String? @db.Text

  user_id    Int?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  customer         Customer          @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  sale_items       Sale_item[]
  sale_attachments Sale_attachment[]
  sale_payments    Sale_payment[]
  sale_additional  sale_additional?

  @@map("sales")
}

model Sale_item {
  id         Int @id @default(autoincrement())
  sale_id    Int
  product_id Int
  tax_id     Int

  quantity   Int      @default(1)
  unit_price Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  tax_price  Decimal  @db.Decimal(12, 2)
  discount   Decimal? @db.Decimal(12, 2) //persen

  tax     Tax     @relation(fields: [tax_id], references: [id], onDelete: Restrict)
  sale    Sale    @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model Sale_attachment {
  id         Int      @id @default(autoincrement())
  sale_id    Int
  file_name  String   @db.VarChar(255) // nama asli file (misal: "PO_Customer_A.pdf")
  file_path  String   @db.VarChar(500) // URL/path penyimpanan (misal: "uploads/sales/abc-123.pdf" atau S3 URL)
  file_type  String   @db.VarChar(100) // MIME type (misal: "application/pdf", "image/jpeg", "image/png")
  remarks    String?  @db.Text // Catatan tambahan (opsional)
  // file_size     Int? // Ukuran file dalam bytes (opsional tapi berguna)
  // document_type String?  @db.VarChar(50) // Jenis dokumen: "PO", "PAYMENT_PROOF", "SIGNED_SPK", "OTHER"
  created_at DateTime @default(now()) @db.Timestamptz(6)

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@map("sale_attachments")
}

model Tax {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  rate       Decimal   @db.Decimal(5, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  sale_items Sale_item[]

  @@map("taxes")
}

model sale_additional {
  id          Int       @id @default(autoincrement())
  sale_id     Int       @unique
  no_po_bis   String?   @db.VarChar(100)
  date_po_bis DateTime? @db.Timestamptz(6)

  remarks    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@map("sale_additionals")
}

model Sale_payment {
  id                       Int                       @id @default(autoincrement())
  sale_id                  Int
  payment_date             DateTime                  @default(now()) @db.Timestamptz(6)
  amount                   Decimal                   @db.Decimal(12, 2)
  method                   String                    @db.VarChar(100)
  remarks                  String?                   @db.Text
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                 @updatedAt @db.Timestamptz(6)
  sale_payment_attachments Sale_payment_attachment[]

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

model Sale_payment_attachment {
  id              Int      @id @default(autoincrement())
  sale_payment_id Int
  file_name       String   @db.VarChar(255) // nama asli file (misal: "Payment_Proof_A.pdf")
  file_path       String   @db.VarChar(500) // URL/path penyimpanan (misal: "uploads/sales/payments/abc-123.pdf" atau S3 URL)
  file_type       String   @db.VarChar(100) // MIME type (misal: "application/pdf", "image/jpeg", "image/png")
  remarks         String?  @db.Text // Catatan tambahan (opsional)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  sale_payment Sale_payment @relation(fields: [sale_payment_id], references: [id], onDelete: Cascade)

  @@map("sale_payment_attachments")
}
